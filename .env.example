TEST_DATABASE_URL="mysql://ieo:REPLACE_WITH_MYSQL_PASSWORD@127.0.0.1:3307/ieo_test"
AUTH_SECRET=
APP_ORIGIN="http://localhost:3000"
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=30
SEED_ADMIN_EMAIL="admin@ieo.local"
SEED_ADMIN_PASSWORD=
