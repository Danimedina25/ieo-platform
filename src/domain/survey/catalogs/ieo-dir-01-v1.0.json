      "allowNA": false,
      "officialOrder": 69,
      "orderInElement": 3,
      "displayOrder": 69,
      "sourceGlobalId": 142,
      "sourceOfficialCode": "DIR-IA-03",
      "sourceLocator": "S05 04_REACTIVOS!A145"
    },
    {
      "code": "DIR_E08_R070",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "Existe apertura para experimentar nuevas ideas antes de que los cambios del entorno obliguen a hacerlo.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 70,
      "orderInElement": 4,
      "displayOrder": 70,
      "sourceGlobalId": 143,
      "sourceOfficialCode": "DIR-IA-04",
      "sourceLocator": "S05 04_REACTIVOS!A146"
    },
    {
      "code": "DIR_E08_R071",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La organización desarrolla nuevas capacidades para responder a los desafíos futuros.",
      "orientation": "DIRECT",
