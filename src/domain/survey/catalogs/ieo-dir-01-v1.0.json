      "allowNA": false,
      "officialOrder": 60,
      "orderInElement": 2,
      "displayOrder": 60,
      "sourceGlobalId": 133,
      "sourceOfficialCode": "DIR-SC-02",
      "sourceLocator": "S05 04_REACTIVOS!A136"
    },
    {
      "code": "DIR_E07_R061",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "Las decisiones estratégicas consideran sistemáticamente las necesidades, expectativas y cambios en el comportamiento de los clientes.",
