      "allowNA": false,
      "officialOrder": 66,
      "orderInElement": 8,
      "displayOrder": 66,
      "sourceGlobalId": 139,
      "sourceOfficialCode": "DIR-SC-08",
      "sourceLocator": "S05 04_REACTIVOS!A142"
    },
    {
      "code": "DIR_E08_R067",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La Alta Dirección monitorea de manera sistemática los cambios del entorno que pueden afectar el futuro de la organización.",
