      "allowNA": false,
      "officialOrder": 67,
      "orderInElement": 1,
      "displayOrder": 67,
      "sourceGlobalId": 140,
      "sourceOfficialCode": "DIR-IA-01",
      "sourceLocator": "S05 04_REACTIVOS!A143"
    },
    {
      "code": "DIR_E08_R068",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La organización promueve una cultura de aprendizaje continuo.",
