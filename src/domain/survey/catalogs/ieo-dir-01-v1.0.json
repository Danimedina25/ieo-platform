      "allowNA": false,
      "officialOrder": 72,
      "orderInElement": 6,
      "displayOrder": 72,
      "sourceGlobalId": 145,
      "sourceOfficialCode": "DIR-IA-06",
      "sourceLocator": "S05 04_REACTIVOS!A148"
    },
    {
      "code": "DIR_E08_R073",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La organización identifica oportunamente riesgos emergentes y actúa de manera preventiva.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 73,
      "orderInElement": 7,
      "displayOrder": 73,
      "sourceGlobalId": 146,
      "sourceOfficialCode": "DIR-IA-07",
      "sourceLocator": "S05 04_REACTIVOS!A149"
    },
    {
      "code": "DIR_E08_R074",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La innovación forma parte de la planeación estratégica y recibe recursos para su desarrollo.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 74,
      "orderInElement": 8,
      "displayOrder": 74,
      "sourceGlobalId": 147,
      "sourceOfficialCode": "DIR-IA-08",
      "sourceLocator": "S05 04_REACTIVOS!A150"
    },
    {
      "code": "DIR_E08_R075",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La organización posee la capacidad de adaptarse con rapidez sin perder su identidad y propósito.",
