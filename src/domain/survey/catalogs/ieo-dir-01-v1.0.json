      "sourceOfficialCode": "DIR-CR-06",
      "sourceLocator": "S05 04_REACTIVOS!A132"
    },
    {
      "code": "DIR_E06_R057",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Las relaciones con clientes, proveedores y aliados estratégicos se construyen sobre bases de confianza y beneficio mutuo.",
