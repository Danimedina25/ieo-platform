      "officialOrder": 71,
      "orderInElement": 5,
      "displayOrder": 71,
      "sourceGlobalId": 144,
      "sourceOfficialCode": "DIR-IA-05",
      "sourceLocator": "S05 04_REACTIVOS!A147"
    },
    {
      "code": "DIR_E08_R072",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La incorporación de nuevas tecnologías responde a una estrategia claramente definida y no únicamente a tendencias del mercado.",
