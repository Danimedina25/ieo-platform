      "sourceLocator": "S05 04_REACTIVOS!A113"
    },
    {
      "code": "DIR_E04_R038",
      "kind": "QUANT",
      "sectionOrder": 4,
      "elementCode": "E04",
      "text": "Los errores se utilizan principalmente como oportunidades de aprendizaje y mejora.",
