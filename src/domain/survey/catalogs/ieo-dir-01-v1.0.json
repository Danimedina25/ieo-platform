      "allowNA": false,
      "officialOrder": 39,
      "orderInElement": 9,
      "displayOrder": 39,
      "sourceGlobalId": 112,
      "sourceOfficialCode": "DIR-LI-09",
      "sourceLocator": "S05 04_REACTIVOS!A115"
    },
    {
      "code": "DIR_E04_R040",
      "kind": "QUANT",
      "sectionOrder": 4,
      "elementCode": "E04",
      "text": "El liderazgo ejercido por la Alta Dirección fortalece el compromiso, la innovación y la colaboración.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 40,
      "orderInElement": 10,
      "displayOrder": 40,
      "sourceGlobalId": 113,
      "sourceOfficialCode": "DIR-LI-10",
      "sourceLocator": "S05 04_REACTIVOS!A116"
    },
    {
      "code": "DIR_E05_R041",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La Alta Dirección considera a las personas como un activo estratégico para el éxito de la organización.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 41,
      "orderInElement": 1,
      "displayOrder": 41,
      "sourceGlobalId": 114,
      "sourceOfficialCode": "DIR-PC-01",
      "sourceLocator": "S05 04_REACTIVOS!A117"
    },
    {
      "code": "DIR_E05_R042",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "Las decisiones relevantes consideran su impacto sobre las personas y la cultura organizacional.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 42,
      "orderInElement": 2,
      "displayOrder": 42,
      "sourceGlobalId": 115,
      "sourceOfficialCode": "DIR-PC-02",
      "sourceLocator": "S05 04_REACTIVOS!A118"
    },
    {
      "code": "DIR_E05_R043",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La organización promueve un ambiente de respeto, inclusión y dignidad para todos sus colaboradores.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 43,
      "orderInElement": 3,
      "displayOrder": 43,
      "sourceGlobalId": 116,
      "sourceOfficialCode": "DIR-PC-03",
      "sourceLocator": "S05 04_REACTIVOS!A119"
    },
    {
      "code": "DIR_E05_R044",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La organización demuestra una preocupación genuina por el bienestar integral de las personas.",
