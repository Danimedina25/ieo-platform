      "allowNA": false,
      "officialOrder": 63,
      "orderInElement": 5,
      "displayOrder": 63,
      "sourceGlobalId": 136,
      "sourceOfficialCode": "DIR-SC-05",
      "sourceLocator": "S05 04_REACTIVOS!A139"
    },
    {
      "code": "DIR_E07_R064",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "Las diferentes áreas colaboran para ofrecer una experiencia consistente al cliente.",
