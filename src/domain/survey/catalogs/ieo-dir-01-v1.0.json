      "allowNA": false,
      "officialOrder": 64,
      "orderInElement": 6,
      "displayOrder": 64,
      "sourceGlobalId": 137,
      "sourceOfficialCode": "DIR-SC-06",
      "sourceLocator": "S05 04_REACTIVOS!A140"
    },
    {
      "code": "DIR_E07_R065",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "La organización responde con rapidez, responsabilidad y aprendizaje cuando un cliente experimenta un problema.",
