      "allowNA": false,
      "officialOrder": 54,
      "orderInElement": 4,
      "displayOrder": 54,
      "sourceGlobalId": 127,
      "sourceOfficialCode": "DIR-CR-04",
      "sourceLocator": "S05 04_REACTIVOS!A130"
    },
    {
      "code": "DIR_E06_R055",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "La organización cumple consistentemente los compromisos que establece.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 55,
      "orderInElement": 5,
      "displayOrder": 55,
      "sourceGlobalId": 128,
      "sourceOfficialCode": "DIR-CR-05",
      "sourceLocator": "S05 04_REACTIVOS!A131"
    },
    {
      "code": "DIR_E06_R056",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Existen mecanismos para identificar y gestionar oportunamente los riesgos reputacionales.",
