      "allowNA": false,
      "officialOrder": 52,
      "orderInElement": 2,
      "displayOrder": 52,
      "sourceGlobalId": 125,
      "sourceOfficialCode": "DIR-CR-02",
      "sourceLocator": "S05 04_REACTIVOS!A128"
    },
    {
      "code": "DIR_E06_R053",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "La organización actúa con transparencia e integridad incluso en situaciones difíciles.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 53,
      "orderInElement": 3,
      "displayOrder": 53,
      "sourceGlobalId": 126,
      "sourceOfficialCode": "DIR-CR-03",
      "sourceLocator": "S05 04_REACTIVOS!A129"
    },
    {
      "code": "DIR_E06_R054",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Existe congruencia entre los valores declarados y las decisiones que realmente se toman.",
