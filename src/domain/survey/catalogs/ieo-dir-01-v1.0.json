      "allowNA": false,
      "officialOrder": 44,
      "orderInElement": 4,
      "displayOrder": 44,
      "sourceGlobalId": 117,
      "sourceOfficialCode": "DIR-PC-04",
      "sourceLocator": "S05 04_REACTIVOS!A120"
    },
    {
      "code": "DIR_E05_R045",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "Los colaboradores cuentan con oportunidades reales de crecimiento y desarrollo profesional.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 45,
      "orderInElement": 5,
      "displayOrder": 45,
      "sourceGlobalId": 118,
      "sourceOfficialCode": "DIR-PC-05",
      "sourceLocator": "S05 04_REACTIVOS!A121"
    },
    {
      "code": "DIR_E05_R046",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La organización reconoce y valora las contribuciones que fortalecen los resultados y la cultura.",
