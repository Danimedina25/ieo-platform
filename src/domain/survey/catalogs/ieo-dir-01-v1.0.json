      "allowNA": false,
      "officialOrder": 65,
      "orderInElement": 7,
      "displayOrder": 65,
      "sourceGlobalId": 138,
      "sourceOfficialCode": "DIR-SC-07",
      "sourceLocator": "S05 04_REACTIVOS!A141"
    },
    {
      "code": "DIR_E07_R066",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "La cultura organizacional promueve relaciones duraderas basadas en la generación continua de valor para el cliente.",
