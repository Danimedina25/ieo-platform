      "allowNA": false,
      "officialOrder": 75,
      "orderInElement": 9,
      "displayOrder": 75,
      "sourceGlobalId": 148,
      "sourceOfficialCode": "DIR-IA-09",
      "sourceLocator": "S05 04_REACTIVOS!A151"
    }
