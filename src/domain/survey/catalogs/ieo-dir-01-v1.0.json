      "allowNA": false,
      "officialOrder": 62,
      "orderInElement": 4,
      "displayOrder": 62,
      "sourceGlobalId": 135,
      "sourceOfficialCode": "DIR-SC-04",
      "sourceLocator": "S05 04_REACTIVOS!A138"
