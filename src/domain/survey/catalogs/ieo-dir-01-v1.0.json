      "allowNA": false,
      "officialOrder": 57,
      "orderInElement": 7,
      "displayOrder": 57,
      "sourceGlobalId": 130,
      "sourceOfficialCode": "DIR-CR-07",
      "sourceLocator": "S05 04_REACTIVOS!A133"
    },
    {
      "code": "DIR_E06_R058",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "La reputación institucional representa una ventaja competitiva para la organización.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 58,
      "orderInElement": 8,
      "displayOrder": 58,
      "sourceGlobalId": 131,
      "sourceOfficialCode": "DIR-CR-08",
      "sourceLocator": "S05 04_REACTIVOS!A134"
    },
    {
      "code": "DIR_E07_R059",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "La satisfacción y el éxito del cliente constituyen una prioridad estratégica para la organización.",
