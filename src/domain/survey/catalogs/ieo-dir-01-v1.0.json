      "allowNA": false,
      "officialOrder": 68,
      "orderInElement": 2,
      "displayOrder": 68,
      "sourceGlobalId": 141,
      "sourceOfficialCode": "DIR-IA-02",
      "sourceLocator": "S05 04_REACTIVOS!A144"
    },
    {
      "code": "DIR_E08_R069",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
      "text": "La organización cuestiona periódicamente sus modelos de trabajo para identificar oportunidades de mejora.",
