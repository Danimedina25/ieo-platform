      "allowNA": false,
      "officialOrder": 59,
      "orderInElement": 1,
      "displayOrder": 59,
      "sourceGlobalId": 132,
      "sourceOfficialCode": "DIR-SC-01",
      "sourceLocator": "S05 04_REACTIVOS!A135"
    },
    {
      "code": "DIR_E07_R060",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "La Alta Dirección recibe información confiable y periódica sobre la experiencia de los clientes.",
