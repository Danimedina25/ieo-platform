      "allowNA": false,
      "officialOrder": 46,
      "orderInElement": 6,
      "displayOrder": 46,
      "sourceGlobalId": 119,
      "sourceOfficialCode": "DIR-PC-06",
      "sourceLocator": "S05 04_REACTIVOS!A122"
    },
    {
      "code": "DIR_E05_R047",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La Alta Dirección escucha activamente las inquietudes y propuestas de los colaboradores.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 47,
      "orderInElement": 7,
      "displayOrder": 47,
      "sourceGlobalId": 120,
      "sourceOfficialCode": "DIR-PC-07",
      "sourceLocator": "S05 04_REACTIVOS!A123"
    },
    {
      "code": "DIR_E05_R048",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "Las decisiones relacionadas con las personas se toman con criterios claros, justos y consistentes.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 48,
      "orderInElement": 8,
      "displayOrder": 48,
      "sourceGlobalId": 121,
      "sourceOfficialCode": "DIR-PC-08",
      "sourceLocator": "S05 04_REACTIVOS!A124"
    },
    {
      "code": "DIR_E05_R049",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La organización mantiene un equilibrio adecuado entre el logro de resultados y el bienestar de las personas.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 49,
      "orderInElement": 9,
      "displayOrder": 49,
      "sourceGlobalId": 122,
      "sourceOfficialCode": "DIR-PC-09",
      "sourceLocator": "S05 04_REACTIVOS!A125"
    },
    {
      "code": "DIR_E05_R050",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La cultura organizacional fortalece el sentido de pertenencia y compromiso de sus integrantes.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 50,
      "orderInElement": 10,
      "displayOrder": 50,
      "sourceGlobalId": 123,
      "sourceOfficialCode": "DIR-PC-10",
      "sourceLocator": "S05 04_REACTIVOS!A126"
    },
    {
      "code": "DIR_E06_R051",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "La Alta Dirección considera la reputación de la organización como un activo estratégico.",
      "orientation": "DIRECT",
      "allowNA": false,
      "officialOrder": 51,
      "orderInElement": 1,
      "displayOrder": 51,
      "sourceGlobalId": 124,
      "sourceOfficialCode": "DIR-CR-01",
      "sourceLocator": "S05 04_REACTIVOS!A127"
    },
    {
      "code": "DIR_E06_R052",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Las decisiones importantes consideran su impacto sobre la confianza de los principales grupos de interés.",
