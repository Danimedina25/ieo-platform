      "allowNA": false,
      "officialOrder": 61,
      "orderInElement": 3,
      "displayOrder": 61,
      "sourceGlobalId": 134,
      "sourceOfficialCode": "DIR-SC-03",
      "sourceLocator": "S05 04_REACTIVOS!A137"
    },
    {
      "code": "DIR_E07_R062",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "La organización cuenta con mecanismos efectivos para escuchar y comprender la voz del cliente.",
