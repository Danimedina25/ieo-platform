      "orderInElement": 8,
      "displayOrder": 38,
      "sourceGlobalId": 111,
      "sourceOfficialCode": "DIR-LI-08",
      "sourceLocator": "S05 04_REACTIVOS!A114"
    },
    {
      "code": "DIR_E04_R039",
      "kind": "QUANT",
      "sectionOrder": 4,
      "elementCode": "E04",
      "text": "Existe una cultura de responsabilidad compartida que evita la dependencia de unos cuantos líderes.",
