      "sourceOfficialCode": "LID-IA-06",
      "sourceLocator": "S05 04_REACTIVOS!A218"
    },
    {
      "code": "LID_E08_R068",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
