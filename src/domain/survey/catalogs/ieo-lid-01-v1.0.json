      "orderInElement": 5,
      "displayOrder": 73,
      "sourceGlobalId": 214,
      "sourceOfficialCode": "LID-IA-05",
      "sourceLocator": "S05 04_REACTIVOS!A217"
    },
    {
      "code": "LID_E08_R067",
      "kind": "QUANT",
      "sectionOrder": 8,
      "elementCode": "E08",
