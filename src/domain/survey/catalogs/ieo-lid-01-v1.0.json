      "orderInElement": 5,
      "displayOrder": 45,
      "sourceGlobalId": 189,
      "sourceOfficialCode": "LID-PC-05",
      "sourceLocator": "S05 04_REACTIVOS!A192"
    },
    {
      "code": "LID_E05_R042",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "Las decisiones relacionadas con los colaboradores se aplican con criterios claros y consistentes.",
