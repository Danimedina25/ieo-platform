      "sourceOfficialCode": "LID-PC-04",
      "sourceLocator": "S05 04_REACTIVOS!A191"
    },
    {
      "code": "LID_E05_R041",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La organización procura mantener un equilibrio razonable entre las exigencias de resultados y el bienestar de las personas.",
