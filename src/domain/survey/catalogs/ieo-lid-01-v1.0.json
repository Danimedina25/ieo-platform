      "allowNA": true,
      "officialOrder": 42,
      "orderInElement": 6,
      "displayOrder": 46,
      "sourceGlobalId": 190,
      "sourceOfficialCode": "LID-PC-06",
      "sourceLocator": "S05 04_REACTIVOS!A193"
    },
    {
      "code": "LID_E05_R043",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La organización escucha las inquietudes y necesidades que los líderes identificamos en nuestros equipos.",
