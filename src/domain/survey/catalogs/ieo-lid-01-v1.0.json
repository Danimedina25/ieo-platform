      "allowNA": true,
      "officialOrder": 50,
      "orderInElement": 5,
      "displayOrder": 55,
      "sourceGlobalId": 198,
      "sourceOfficialCode": "LID-CR-05",
      "sourceLocator": "S05 04_REACTIVOS!A201"
    },
    {
      "code": "LID_E06_R051",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Los líderes de la organización comprenden que su comportamiento influye en la reputación institucional.",
