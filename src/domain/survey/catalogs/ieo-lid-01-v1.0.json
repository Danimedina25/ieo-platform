    },
    {
      "code": "LID_E05_R037",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "Puedo identificar oportunamente señales de desmotivación o pérdida de compromiso dentro de mi equipo.",
      "orientation": "DIRECT",
      "allowNA": true,
