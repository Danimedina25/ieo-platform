      "sourceOfficialCode": "LID-PC-01",
      "sourceLocator": "S05 04_REACTIVOS!A188"
    },
    {
      "code": "LID_E05_R038",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La organización proporciona condiciones para reconocer las contribuciones relevantes de los colaboradores.",
      "orientation": "DIRECT",
      "allowNA": true,
      "officialOrder": 38,
      "orderInElement": 2,
