      "sourceLocator": "S05 04_REACTIVOS!A189"
    },
    {
      "code": "LID_E05_R039",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "Existen oportunidades reales de aprendizaje y desarrollo para las personas de mi equipo.",
