      "orderInElement": 3,
      "displayOrder": 53,
      "sourceGlobalId": 196,
      "sourceOfficialCode": "LID-CR-03",
      "sourceLocator": "S05 04_REACTIVOS!A199"
    },
    {
      "code": "LID_E06_R049",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "La organización procura cumplir los compromisos establecidos con clientes, proveedores y otros grupos de interés.",
