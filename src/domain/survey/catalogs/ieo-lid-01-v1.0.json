      "sourceOfficialCode": "LID-CR-06",
      "sourceLocator": "S05 04_REACTIVOS!A202"
    },
    {
      "code": "LID_E06_R052",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "La organización actúa oportunamente ante comportamientos que contradicen sus principios o comprometen su credibilidad.",
