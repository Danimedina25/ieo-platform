      "officialOrder": 55,
      "orderInElement": 2,
      "displayOrder": 61,
      "sourceGlobalId": 203,
      "sourceOfficialCode": "LID-SC-02",
      "sourceLocator": "S05 04_REACTIVOS!A206"
    },
    {
      "code": "LID_E07_R056",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "Recibo información suficiente sobre la experiencia y retroalimentación de los clientes.",
