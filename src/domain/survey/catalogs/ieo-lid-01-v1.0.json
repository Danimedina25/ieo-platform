      "orderInElement": 1,
      "displayOrder": 60,
      "sourceGlobalId": 202,
      "sourceOfficialCode": "LID-SC-01",
      "sourceLocator": "S05 04_REACTIVOS!A205"
    },
    {
      "code": "LID_E07_R055",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "Mi equipo comprende cómo sus decisiones y acciones afectan la experiencia del cliente.",
