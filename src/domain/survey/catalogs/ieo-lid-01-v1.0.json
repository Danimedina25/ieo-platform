      "sourceOfficialCode": null,
      "sourceLocator": "S05 05_ABIERTAS!A16"
    },
    {
      "code": "LID_E06_R046",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Las decisiones de la organización son congruentes con los valores y principios que promueve.",
