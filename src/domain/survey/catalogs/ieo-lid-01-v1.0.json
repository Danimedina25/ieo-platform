      "allowNA": true,
      "officialOrder": 45,
      "orderInElement": 9,
      "displayOrder": 49,
      "sourceGlobalId": 193,
      "sourceOfficialCode": "LID-PC-09",
      "sourceLocator": "S05 04_REACTIVOS!A196"
    },
    {
      "code": "LID_E05_O05",
      "kind": "OPEN",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "¿Qué factor consideras que actualmente fortalece o debilita más el compromiso de las personas de tu equipo?",
