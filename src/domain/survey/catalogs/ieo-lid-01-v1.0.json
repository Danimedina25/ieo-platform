      "orderInElement": 8,
      "displayOrder": 48,
      "sourceGlobalId": 192,
      "sourceOfficialCode": "LID-PC-08",
      "sourceLocator": "S05 04_REACTIVOS!A195"
    },
    {
      "code": "LID_E05_R045",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "Las personas de mi equipo comprenden cómo su trabajo contribuye a los objetivos y propósito de la organización.",
