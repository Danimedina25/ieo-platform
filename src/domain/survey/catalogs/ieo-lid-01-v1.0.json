      "allowNA": true,
      "officialOrder": 49,
      "orderInElement": 4,
      "displayOrder": 54,
      "sourceGlobalId": 197,
      "sourceOfficialCode": "LID-CR-04",
      "sourceLocator": "S05 04_REACTIVOS!A200"
    },
    {
      "code": "LID_E06_R050",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Cuando ocurre un error relevante, la organización procura reconocerlo y tomar acciones para corregirlo.",
