      "allowNA": true,
      "officialOrder": 46,
      "orderInElement": 1,
      "displayOrder": 51,
      "sourceGlobalId": 194,
      "sourceOfficialCode": "LID-CR-01",
      "sourceLocator": "S05 04_REACTIVOS!A197"
    },
    {
      "code": "LID_E06_R047",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "Los líderes recibimos información suficiente para comunicar con transparencia las decisiones relevantes a nuestros equipos.",
      "orientation": "DIRECT",
      "allowNA": true,
      "officialOrder": 47,
      "orderInElement": 2,
      "displayOrder": 52,
      "sourceGlobalId": 195,
      "sourceOfficialCode": "LID-CR-02",
      "sourceLocator": "S05 04_REACTIVOS!A198"
    },
    {
      "code": "LID_E06_R048",
      "kind": "QUANT",
      "sectionOrder": 6,
      "elementCode": "E06",
      "text": "La organización cumple de manera consistente los compromisos que establece con sus colaboradores.",
