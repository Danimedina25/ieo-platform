      "displayOrder": 64,
      "sourceGlobalId": 206,
      "sourceOfficialCode": "LID-SC-05",
      "sourceLocator": "S05 04_REACTIVOS!A209"
    },
    {
      "code": "LID_E07_R059",
      "kind": "QUANT",
      "sectionOrder": 7,
      "elementCode": "E07",
      "text": "Existe coordinación entre las diferentes áreas para resolver situaciones que afectan la experiencia del cliente.",
