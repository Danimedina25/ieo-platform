      "sourceGlobalId": 191,
      "sourceOfficialCode": "LID-PC-07",
      "sourceLocator": "S05 04_REACTIVOS!A194"
    },
    {
      "code": "LID_E05_R044",
      "kind": "QUANT",
      "sectionOrder": 5,
      "elementCode": "E05",
      "text": "La cultura de la organización favorece relaciones de respeto y colaboración entre las personas.",
