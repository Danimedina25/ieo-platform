generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

enum UserStatus {
  ACTIVE
  DISABLED
}
enum OrganizationStatus {
  ACTIVE
  INACTIVE
}
enum OrganizationRole {
  IEO_CONSULTANT
  ORG_COORDINATOR
}
enum AssessmentStatus {
  DRAFT
}
enum PerspectiveCode {
  DIR
  ESP
  LID
  COL
  CLI
}
enum PerspectiveApplicability {
  APPLICABLE
  NOT_APPLICABLE
  NOT_AVAILABLE
}
enum CollectionMode {
  CENSUS
  SAMPLE
}
enum CliUnitType {
  B2B
  B2C
}
enum ReportabilityStatus {
  PENDING
  REPORTABLE
  NOT_REPORTABLE
}
enum InvitationStatus {
  CREATED
  SENT
  VERIFIED
  COMPLETED
  CANCELLED
  EXPIRED
}
enum ResponseSessionStatus {
  STARTED
  SUBMITTED
  INVALIDATED
}
enum SurveyItemType {
  LIKERT
  TEXT
}
enum SurveyAnswerState {
  MISSING
  VALUE
  NA
}
enum ElementCode {
  E01
  E02
  E03
  E04
  E05
  E06
  E07
  E08
}
enum QuestionKind {
  QUANT
  OPEN
}
enum QuestionOrientation {
  DIRECT
  REVERSE
}
enum AuditAction {
  TEST_INVITATION_CREATED
  TEST_INVITATION_REISSUED
  TEST_INVITATION_CANCELLED
  PARTICIPANT_TEST_SUBMITTED
  INSTRUMENT_VERSION_LOADED
  ORGANIZATION_CREATED
  ASSESSMENT_CREATED
  ASSESSMENT_UPDATED
  PERSPECTIVE_UPDATED
  SEGMENT_CREATED
  SEGMENT_UPDATED
  SEGMENT_DEACTIVATED
  ADMIN_LOGIN
  ADMIN_LOGOUT
  LOGIN_FAILED
  USER_DISABLED_SESSION_REJECTED
}

model User {
  id             String     @id @default(uuid()) @db.Char(36)
  email          String     @unique @db.VarChar(254)
  name           String?    @db.VarChar(120)
  passwordHash   String     @db.VarChar(255)
  status         UserStatus @default(ACTIVE)
  technicalAdmin Boolean    @default(false)
  createdAt      DateTime   @default(now()) @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @db.DateTime(3)
  sessions       AdminSession[]
  memberships    OrganizationMembership[]
  auditLogs      AuditLog[]
  consultantAssessments Assessment[] @relation("AssessmentConsultant")
  coordinatorAssessments Assessment[] @relation("AssessmentCoordinator")
  createdInvitations Invitation[]
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.DateTime(3)
  lastSeenAt DateTime  @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
}

model Organization {
  id          String             @id @default(uuid()) @db.Char(36)
  name        String             @db.VarChar(160)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @db.DateTime(3)
  memberships OrganizationMembership[]
  assessments Assessment[]
  auditLogs   AuditLog[]
}

model OrganizationMembership {
  organizationId String           @db.Char(36)
  userId         String           @db.Char(36)
  role           OrganizationRole
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([organizationId, userId, role])
  @@index([userId, active])
}

model Assessment {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  name           String           @db.VarChar(160)
  period         String           @db.VarChar(80)
  status         AssessmentStatus @default(DRAFT)
  objective      String?          @db.Text
  timezone       String?          @db.VarChar(64)
  plannedOpensAt DateTime?        @db.DateTime(3)
  plannedClosesAt DateTime?       @db.DateTime(3)
  scopeUnitsText String?          @db.Text
  sponsorName    String?          @db.VarChar(160)
  consultantUserId String?        @db.Char(36)
  coordinatorUserId String?       @db.Char(36)
  methodologyNotes String?        @db.Text
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @db.DateTime(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditLogs      AuditLog[]
  consultant     User?            @relation("AssessmentConsultant", fields: [consultantUserId], references: [id], onDelete: Restrict)
  coordinator    User?            @relation("AssessmentCoordinator", fields: [coordinatorUserId], references: [id], onDelete: Restrict)
  perspectives   AssessmentPerspective[]
  segments       Segment[]
  invitations    Invitation[]
  responseSessions ResponseSession[]
  @@index([consultantUserId])
  @@index([coordinatorUserId])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Char(36)
  organizationId String?     @db.Char(36)
  assessmentId   String?     @db.Char(36)
  actorUserId    String?     @db.Char(36)
  action         AuditAction
  entityType     String      @db.VarChar(40)
  entityId       String?     @db.Char(36)
  metadataJson   Json?
  createdAt      DateTime    @default(now()) @db.DateTime(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assessment     Assessment? @relation(fields: [organizationId, assessmentId], references: [organizationId, id], onDelete: Restrict)
  actor          User?       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([organizationId, assessmentId, createdAt])
  @@index([actorUserId, createdAt])
}

model AssessmentPerspective {
  id                 String                    @id @default(uuid()) @db.Char(36)
  assessmentId       String                    @db.Char(36)
  perspectiveCode    PerspectiveCode
  applicability      PerspectiveApplicability?
  populationEstimate Int?
  collectionMode     CollectionMode?
  notes              String?                   @db.Text
  cliUnitType        CliUnitType?
  createdAt          DateTime                  @default(now()) @db.DateTime(3)
  updatedAt          DateTime                  @updatedAt @db.DateTime(3)
  assessment         Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  invitations        Invitation[]
  responseSessions   ResponseSession[]
  @@unique([assessmentId, perspectiveCode])
  @@unique([assessmentId, id])
}

model Segment {
  id                  String              @id @default(uuid()) @db.Char(36)
  assessmentId        String              @db.Char(36)
  dimension           String              @db.VarChar(80)
  label               String              @db.VarChar(160)
  reportabilityStatus ReportabilityStatus @default(PENDING)
  reason              String?             @db.Text
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now()) @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @db.DateTime(3)
  assessment          Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  @@unique([assessmentId, dimension, label])
  @@index([assessmentId, active])
}

model Invitation {
  id                      String           @id @default(uuid()) @db.Char(36)
  assessmentId            String           @db.Char(36)
  assessmentPerspectiveId String           @db.Char(36)
  emailCiphertext         String           @db.Text
  emailLookupHmac         String           @db.Char(64)
  tokenHash               String           @unique @db.Char(64)
  tokenGeneration         Int              @default(1)
  status                  InvitationStatus @default(CREATED)
  expiresAt               DateTime         @db.DateTime(3)
  sentAt                  DateTime?        @db.DateTime(3)
  verifiedAt              DateTime?        @db.DateTime(3)
  completedAt             DateTime?        @db.DateTime(3)
  cancelledAt             DateTime?        @db.DateTime(3)
  isTest                  Boolean          @default(true)
  createdById             String           @db.Char(36)
  createdAt               DateTime         @default(now()) @db.DateTime(3)
  updatedAt               DateTime         @updatedAt @db.DateTime(3)
  assessment              Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  perspective             AssessmentPerspective @relation(fields: [assessmentId, assessmentPerspectiveId], references: [assessmentId, id], onDelete: Restrict)
  createdBy               User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  challenges              AccessChallenge[]
  binding                 ParticipantAccessBinding?
  @@unique([assessmentPerspectiveId, emailLookupHmac])
  @@index([assessmentId, status])
  @@index([createdById])
}

model AccessChallenge {
  id              String     @id @default(uuid()) @db.Char(36)
  invitationId    String     @db.Char(36)
  tokenGeneration Int
  contextHash     String     @unique @db.Char(64)
  otpHmac         String     @db.Char(64)
  expiresAt       DateTime   @db.DateTime(3)
  attempts        Int        @default(0)
  consumedAt      DateTime?  @db.DateTime(3)
  invalidatedAt   DateTime?  @db.DateTime(3)
  createdAt       DateTime   @default(now()) @db.DateTime(3)
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  @@index([invitationId, createdAt])
}

model ParticipantAccessBinding {
  id                String      @id @default(uuid()) @db.Char(36)
  invitationId      String      @unique @db.Char(36)
  responseSessionId String      @unique @db.Char(36)
  createdAt         DateTime    @default(now()) @db.DateTime(3)
  revokedAt         DateTime?   @db.DateTime(3)
  invitation        Invitation  @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  responseSession   ResponseSession @relation(fields: [responseSessionId], references: [id], onDelete: Restrict)
  authSessions      ParticipantAuthSession[]
}

model ParticipantAuthSession {
  id              String      @id @default(uuid()) @db.Char(36)
  accessBindingId String      @db.Char(36)
  tokenHash       String      @unique @db.Char(64)
  expiresAt       DateTime    @db.DateTime(3)
  lastSeenAt      DateTime    @db.DateTime(3)
  revokedAt       DateTime?   @db.DateTime(3)
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  binding         ParticipantAccessBinding @relation(fields: [accessBindingId], references: [id], onDelete: Restrict)
  @@index([accessBindingId, expiresAt])
}

model ResponseSession {
  id                      String      @id @default(uuid()) @db.Char(36)
  assessmentId            String      @db.Char(36)
  assessmentPerspectiveId String      @db.Char(36)
  surveyCode              String      @db.VarChar(64)
  surveyVersion           Int
  status                  ResponseSessionStatus @default(STARTED)
  startedAt               DateTime    @default(now()) @db.DateTime(3)
  submittedAt             DateTime?   @db.DateTime(3)
  introAcceptedAt         DateTime?   @db.DateTime(3)
  introVersion            String?     @db.VarChar(40)
  revision                Int         @default(0)
  instrumentVersionId     String?     @db.Char(36)
  isTest                  Boolean     @default(true)
  createdAt               DateTime    @default(now()) @db.DateTime(3)
  updatedAt               DateTime    @updatedAt @db.DateTime(3)
  assessment              Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  perspective             AssessmentPerspective @relation(fields: [assessmentId, assessmentPerspectiveId], references: [assessmentId, id], onDelete: Restrict)
  instrumentVersion       InstrumentVersion? @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  binding                 ParticipantAccessBinding?
  responses               SurveyResponse[]
  instrumentResponses     SurveyResponse[] @relation("SurveyResponseSessionInstrument")
  @@unique([id, instrumentVersionId])
  @@index([assessmentId, assessmentPerspectiveId, status])
  @@index([instrumentVersionId])
}

model SurveyResponse {
  id                String            @id @default(uuid()) @db.Char(36)
  responseSessionId String            @db.Char(36)
  itemKey           String            @db.VarChar(64)
  itemType          SurveyItemType
  answerState       SurveyAnswerState
  numericValue      Int?
  textCiphertext    String?           @db.Text
  instrumentVersionId String?         @db.Char(36)
  questionVersionId String?           @db.Char(36)
  createdAt         DateTime          @default(now()) @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @db.DateTime(3)
  responseSession   ResponseSession   @relation(fields: [responseSessionId], references: [id], onDelete: Restrict)
  sessionInstrument ResponseSession?  @relation("SurveyResponseSessionInstrument", fields: [responseSessionId, instrumentVersionId], references: [id, instrumentVersionId], onDelete: Restrict, onUpdate: Restrict, map: "SurveyResponse_session_instrument_fkey")
  questionVersion   QuestionVersion?  @relation(fields: [instrumentVersionId, questionVersionId], references: [instrumentVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([responseSessionId, itemKey])
  @@unique([responseSessionId, questionVersionId])
  @@index([instrumentVersionId, questionVersionId])
}

model InstrumentVersion {
  id               String          @id @default(uuid()) @db.Char(36)
  instrumentCode   String          @db.VarChar(32)
  version          String          @db.VarChar(16)
  perspectiveCode  PerspectiveCode
  title            String          @db.VarChar(160)
  certified        Boolean         @default(false)
  contentHash      String          @unique @db.Char(64)
  sourcesJson      Json
  correctionsJson  Json
  introJson        Json
  thanksText       String          @db.Text
  createdAt        DateTime        @default(now()) @db.DateTime(3)
  sections         InstrumentSection[]
  questions        QuestionVersion[]
  scaleOptions     InstrumentScaleOption[]
  responseSessions ResponseSession[]
  @@unique([instrumentCode, version])
}

model InstrumentScaleOption {
  instrumentVersionId String            @db.Char(36)
  valueCode           String            @db.VarChar(4)
  label               String            @db.VarChar(120)
  displayOrder        Int
  instrumentVersion   InstrumentVersion @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  @@id([instrumentVersionId, valueCode])
  @@unique([instrumentVersionId, displayOrder])
}

model InstrumentSection {
  id                  String            @id @default(uuid()) @db.Char(36)
  instrumentVersionId String            @db.Char(36)
  elementCode         ElementCode?
  label               String            @db.VarChar(40)
  title               String            @db.VarChar(160)
  introduction        String?           @db.Text
  instructions        String?           @db.Text
  displayOrder        Int
  instrumentVersion   InstrumentVersion @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  questions           QuestionVersion[]
  @@unique([instrumentVersionId, displayOrder])
  @@unique([instrumentVersionId, id])
}

model QuestionVersion {
  id                  String               @id @default(uuid()) @db.Char(36)
  instrumentVersionId String               @db.Char(36)
  sectionId           String               @db.Char(36)
  code                String               @db.VarChar(32)
  kind                QuestionKind
  elementCode         ElementCode?
  text                String               @db.Text
  orientation         QuestionOrientation?
  allowNA             Boolean
  officialOrder       Int
  orderInElement      Int?
  displayOrder        Int
  sourceGlobalId      Int?
  sourceOfficialCode  String?              @db.VarChar(32)
  sourceLocator       String               @db.VarChar(120)
  instrumentVersion   InstrumentVersion    @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  section             InstrumentSection    @relation(fields: [instrumentVersionId, sectionId], references: [instrumentVersionId, id], onDelete: Restrict)
  responses           SurveyResponse[]
  @@unique([instrumentVersionId, code])
  @@unique([instrumentVersionId, displayOrder])
  @@unique([instrumentVersionId, id])
}
