generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

enum UserStatus {
  ACTIVE
  DISABLED
}
enum OrganizationStatus {
  ACTIVE
  INACTIVE
}
enum OrganizationRole {
  IEO_CONSULTANT
  ORG_COORDINATOR
}
enum AssessmentStatus {
  DRAFT
  OPEN
  CLOSED
  FROZEN
  PROCESSED
}
enum PerspectiveCode {
  DIR
  ESP
  LID
  COL
  CLI
}
enum PerspectiveApplicability {
  APPLICABLE
  NOT_APPLICABLE
  NOT_AVAILABLE
}
enum CollectionMode {
  CENSUS
  SAMPLE
}
enum CliUnitType {
  B2B
  B2C
}
enum ReportabilityStatus {
  PENDING
  REPORTABLE
  NOT_REPORTABLE
}
enum InvitationStatus {
  CREATED
  SENT
  VERIFIED
  COMPLETED
  CANCELLED
  EXPIRED
}
enum ResponseSessionStatus {
  STARTED
  SUBMITTED
  INVALIDATED
}
enum SurveyItemType {
  LIKERT
  TEXT
}
enum SurveyAnswerState {
  MISSING
  VALUE
  NA
}
enum ElementCode {
  E01
  E02
  E03
  E04
  E05
  E06
  E07
  E08
}
enum QuestionKind {
  QUANT
  OPEN
}
enum QuestionOrientation {
  DIRECT
  REVERSE
}
enum QualityVerdict {
  A
  B
  C
}
enum ExclusionReason {
  DUPLICATE
  TEST_RESPONSE
  OUT_OF_POPULATION
  TECHNICAL_INCIDENT
  REPORTED_MANIPULATION
}
enum ProcessingStatus {
  SUCCEEDED
  FAILED
}
enum TriangulationPatternCode {
  CONSISTENT_STRENGTH
  CONSISTENT_EROSION
  PERCEPTION_GAP
  MIXED_RESULT
  LIMITED_EVIDENCE
}
enum QualitativeStatus {
  REVIEW_PENDING
  SAFE_FOR_REPORT
  REDACTED
  DO_NOT_QUOTE
}
enum DisclosureDecision {
  REPORTABLE
  NOT_REPORTABLE
}
enum AuditAction {
  TEST_INVITATION_CREATED
  TEST_INVITATION_REISSUED
  TEST_INVITATION_CANCELLED
  PARTICIPANT_TEST_SUBMITTED
  INSTRUMENT_VERSION_LOADED
  METHODOLOGY_PACKAGE_LOADED
  ASSESSMENT_OPENED
  ASSESSMENT_CLOSED
  ASSESSMENT_REOPENED
  EXCLUSION_RECORDED
  EXCLUSION_REVOKED
  INCIDENT_RECORDED
  QUALITY_RECORDED
  CHECKLIST_SAVED
  ASSESSMENT_FROZEN
  PROCESSING_SUCCEEDED
  PROCESSING_FAILED
  PATTERN_RECORDED
  QUALITATIVE_REVIEWED
  DISCLOSURE_RECORDED
  ORGANIZATION_CREATED
  ASSESSMENT_CREATED
  ASSESSMENT_UPDATED
  PERSPECTIVE_UPDATED
  SEGMENT_CREATED
  SEGMENT_UPDATED
  SEGMENT_DEACTIVATED
  ADMIN_LOGIN
  ADMIN_LOGOUT
  LOGIN_FAILED
  USER_DISABLED_SESSION_REJECTED
}

model User {
  id             String     @id @default(uuid()) @db.Char(36)
  email          String     @unique @db.VarChar(254)
  name           String?    @db.VarChar(120)
  passwordHash   String     @db.VarChar(255)
  status         UserStatus @default(ACTIVE)
  technicalAdmin Boolean    @default(false)
  createdAt      DateTime   @default(now()) @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @db.DateTime(3)
  sessions       AdminSession[]
  memberships    OrganizationMembership[]
  auditLogs      AuditLog[]
  consultantAssessments Assessment[] @relation("AssessmentConsultant")
  coordinatorAssessments Assessment[] @relation("AssessmentCoordinator")
  createdInvitations Invitation[]
  authorizedClosures ClosureRecord[] @relation("ClosureAuthorizedBy")
  qualityReviews     QualityAssessment[] @relation("QualityReviewedBy")
  authorizedExclusions Exclusion[] @relation("ExclusionAuthorizedBy")
  revokedExclusions  Exclusion[] @relation("ExclusionRevokedBy")
  incidents          Incident[] @relation("IncidentCreatedBy")
  frozenSnapshots    FrozenSnapshot[] @relation("SnapshotFrozenBy")
  requestedRuns      ProcessingRun[] @relation("RunRequestedBy")
  recordedPatterns   TriangulationPattern[] @relation("PatternRecordedBy")
  qualitativeReviews QualitativeReview[] @relation("QualitativeReviewedBy")
  disclosureReviews  DisclosureReview[] @relation("DisclosureReviewedBy")
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.DateTime(3)
  lastSeenAt DateTime  @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
}

model Organization {
  id          String             @id @default(uuid()) @db.Char(36)
  name        String             @db.VarChar(160)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @db.DateTime(3)
  memberships OrganizationMembership[]
  assessments Assessment[]
  auditLogs   AuditLog[]
}

model OrganizationMembership {
  organizationId String           @db.Char(36)
  userId         String           @db.Char(36)
  role           OrganizationRole
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([organizationId, userId, role])
  @@index([userId, active])
}

model Assessment {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  name           String           @db.VarChar(160)
  period         String           @db.VarChar(80)
  status         AssessmentStatus @default(DRAFT)
  objective      String?          @db.Text
  timezone       String?          @db.VarChar(64)
  plannedOpensAt DateTime?        @db.DateTime(3)
  plannedClosesAt DateTime?       @db.DateTime(3)
  scopeUnitsText String?          @db.Text
  sponsorName    String?          @db.VarChar(160)
  consultantUserId String?        @db.Char(36)
  coordinatorUserId String?       @db.Char(36)
  methodologyNotes String?        @db.Text
  methodologyPackageId String?    @db.Char(36)
  revisionNumber Int              @default(1)
  openedAt       DateTime?        @db.DateTime(3)
  closedAt       DateTime?        @db.DateTime(3)
  currentRunId   String?          @unique @db.Char(36)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @db.DateTime(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auditLogs      AuditLog[]
  consultant     User?            @relation("AssessmentConsultant", fields: [consultantUserId], references: [id], onDelete: Restrict)
  coordinator    User?            @relation("AssessmentCoordinator", fields: [coordinatorUserId], references: [id], onDelete: Restrict)
  methodologyPackage MethodologyPackage? @relation(fields: [methodologyPackageId], references: [id], onDelete: Restrict)
  currentRun     ProcessingRun?   @relation("AssessmentCurrentRun", fields: [currentRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  closureRecords ClosureRecord[]
  qualityAssessments QualityAssessment[]
  exclusions     Exclusion[]
  incidents      Incident[]
  snapshots      FrozenSnapshot[]
  processingRuns ProcessingRun[]  @relation("AssessmentRuns")
  perspectives   AssessmentPerspective[]
  segments       Segment[]
  invitations    Invitation[]
  responseSessions ResponseSession[]
  @@index([consultantUserId])
  @@index([coordinatorUserId])
  @@index([methodologyPackageId])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Char(36)
  organizationId String?     @db.Char(36)
  assessmentId   String?     @db.Char(36)
  actorUserId    String?     @db.Char(36)
  action         AuditAction
  entityType     String      @db.VarChar(40)
  entityId       String?     @db.Char(36)
  metadataJson   Json?
  createdAt      DateTime    @default(now()) @db.DateTime(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assessment     Assessment? @relation(fields: [organizationId, assessmentId], references: [organizationId, id], onDelete: Restrict)
  actor          User?       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([organizationId, assessmentId, createdAt])
  @@index([actorUserId, createdAt])
}

model AssessmentPerspective {
  id                 String                    @id @default(uuid()) @db.Char(36)
  assessmentId       String                    @db.Char(36)
  perspectiveCode    PerspectiveCode
  applicability      PerspectiveApplicability?
  populationEstimate Int?
  collectionMode     CollectionMode?
  notes              String?                   @db.Text
  cliUnitType        CliUnitType?
  createdAt          DateTime                  @default(now()) @db.DateTime(3)
  updatedAt          DateTime                  @updatedAt @db.DateTime(3)
  assessment         Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  invitations        Invitation[]
  responseSessions   ResponseSession[]
  @@unique([assessmentId, perspectiveCode])
  @@unique([assessmentId, id])
}

model Segment {
  id                  String              @id @default(uuid()) @db.Char(36)
  assessmentId        String              @db.Char(36)
  dimension           String              @db.VarChar(80)
  label               String              @db.VarChar(160)
  reportabilityStatus ReportabilityStatus @default(PENDING)
  reason              String?             @db.Text
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now()) @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @db.DateTime(3)
  assessment          Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  @@unique([assessmentId, dimension, label])
  @@index([assessmentId, active])
}

model Invitation {
  id                      String           @id @default(uuid()) @db.Char(36)
  assessmentId            String           @db.Char(36)
  assessmentPerspectiveId String           @db.Char(36)
  emailCiphertext         String           @db.Text
  emailLookupHmac         String           @db.Char(64)
  tokenHash               String           @unique @db.Char(64)
  tokenGeneration         Int              @default(1)
  status                  InvitationStatus @default(CREATED)
  expiresAt               DateTime         @db.DateTime(3)
  sentAt                  DateTime?        @db.DateTime(3)
  verifiedAt              DateTime?        @db.DateTime(3)
  completedAt             DateTime?        @db.DateTime(3)
  cancelledAt             DateTime?        @db.DateTime(3)
  isTest                  Boolean          @default(true)
  createdById             String           @db.Char(36)
  createdAt               DateTime         @default(now()) @db.DateTime(3)
  updatedAt               DateTime         @updatedAt @db.DateTime(3)
  assessment              Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  perspective             AssessmentPerspective @relation(fields: [assessmentId, assessmentPerspectiveId], references: [assessmentId, id], onDelete: Restrict)
  createdBy               User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  challenges              AccessChallenge[]
  binding                 ParticipantAccessBinding?
  @@unique([assessmentPerspectiveId, emailLookupHmac])
  @@index([assessmentId, status])
  @@index([createdById])
}

model AccessChallenge {
  id              String     @id @default(uuid()) @db.Char(36)
  invitationId    String     @db.Char(36)
  tokenGeneration Int
  contextHash     String     @unique @db.Char(64)
  otpHmac         String     @db.Char(64)
  expiresAt       DateTime   @db.DateTime(3)
  attempts        Int        @default(0)
  consumedAt      DateTime?  @db.DateTime(3)
  invalidatedAt   DateTime?  @db.DateTime(3)
  createdAt       DateTime   @default(now()) @db.DateTime(3)
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  @@index([invitationId, createdAt])
}

model ParticipantAccessBinding {
  id                String      @id @default(uuid()) @db.Char(36)
  invitationId      String      @unique @db.Char(36)
  responseSessionId String      @unique @db.Char(36)
  createdAt         DateTime    @default(now()) @db.DateTime(3)
  revokedAt         DateTime?   @db.DateTime(3)
  invitation        Invitation  @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  responseSession   ResponseSession @relation(fields: [responseSessionId], references: [id], onDelete: Restrict)
  authSessions      ParticipantAuthSession[]
}

model ParticipantAuthSession {
  id              String      @id @default(uuid()) @db.Char(36)
  accessBindingId String      @db.Char(36)
  tokenHash       String      @unique @db.Char(64)
  expiresAt       DateTime    @db.DateTime(3)
  lastSeenAt      DateTime    @db.DateTime(3)
  revokedAt       DateTime?   @db.DateTime(3)
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  binding         ParticipantAccessBinding @relation(fields: [accessBindingId], references: [id], onDelete: Restrict)
  @@index([accessBindingId, expiresAt])
}

model ResponseSession {
  id                      String      @id @default(uuid()) @db.Char(36)
  assessmentId            String      @db.Char(36)
  assessmentPerspectiveId String      @db.Char(36)
  surveyCode              String      @db.VarChar(64)
  surveyVersion           Int
  status                  ResponseSessionStatus @default(STARTED)
  startedAt               DateTime    @default(now()) @db.DateTime(3)
  submittedAt             DateTime?   @db.DateTime(3)
  introAcceptedAt         DateTime?   @db.DateTime(3)
  introVersion            String?     @db.VarChar(40)
  revision                Int         @default(0)
  instrumentVersionId     String?     @db.Char(36)
  isTest                  Boolean     @default(true)
  createdAt               DateTime    @default(now()) @db.DateTime(3)
  updatedAt               DateTime    @updatedAt @db.DateTime(3)
  assessment              Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  perspective             AssessmentPerspective @relation(fields: [assessmentId, assessmentPerspectiveId], references: [assessmentId, id], onDelete: Restrict)
  instrumentVersion       InstrumentVersion? @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  binding                 ParticipantAccessBinding?
  responses               SurveyResponse[]
  instrumentResponses     SurveyResponse[] @relation("SurveyResponseSessionInstrument")
  exclusions              Exclusion[]
  @@unique([id, instrumentVersionId])
  @@unique([assessmentId, id])
  @@index([assessmentId, assessmentPerspectiveId, status])
  @@index([instrumentVersionId])
}

model SurveyResponse {
  id                String            @id @default(uuid()) @db.Char(36)
  responseSessionId String            @db.Char(36)
  itemKey           String            @db.VarChar(64)
  itemType          SurveyItemType
  answerState       SurveyAnswerState
  numericValue      Int?
  textCiphertext    String?           @db.Text
  instrumentVersionId String?         @db.Char(36)
  questionVersionId String?           @db.Char(36)
  createdAt         DateTime          @default(now()) @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @db.DateTime(3)
  responseSession   ResponseSession   @relation(fields: [responseSessionId], references: [id], onDelete: Restrict)
  qualitativeReviews QualitativeReview[]
  sessionInstrument ResponseSession?  @relation("SurveyResponseSessionInstrument", fields: [responseSessionId, instrumentVersionId], references: [id, instrumentVersionId], onDelete: Restrict, onUpdate: Restrict, map: "SurveyResponse_session_instrument_fkey")
  questionVersion   QuestionVersion?  @relation(fields: [instrumentVersionId, questionVersionId], references: [instrumentVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([responseSessionId, itemKey])
  @@unique([responseSessionId, questionVersionId])
  @@index([instrumentVersionId, questionVersionId])
}

model InstrumentVersion {
  id               String          @id @default(uuid()) @db.Char(36)
  instrumentCode   String          @db.VarChar(32)
  version          String          @db.VarChar(16)
  perspectiveCode  PerspectiveCode
  title            String          @db.VarChar(160)
  certified        Boolean         @default(false)
  contentHash      String          @unique @db.Char(64)
  sourcesJson      Json
  correctionsJson  Json
  introJson        Json
  thanksText       String          @db.Text
  createdAt        DateTime        @default(now()) @db.DateTime(3)
  sections         InstrumentSection[]
  questions        QuestionVersion[]
  scaleOptions     InstrumentScaleOption[]
  responseSessions ResponseSession[]
  packages         PackageInstrument[]
  @@unique([instrumentCode, version])
  @@unique([id, perspectiveCode])
}

model MethodologyPackage {
  id          String              @id @default(uuid()) @db.Char(36)
  code        String              @db.VarChar(32)
  version     String              @db.VarChar(16)
  title       String              @db.VarChar(160)
  createdAt   DateTime            @default(now()) @db.DateTime(3)
  instruments PackageInstrument[]
  assessments Assessment[]
  @@unique([code, version])
}

model PackageInstrument {
  packageId           String             @db.Char(36)
  perspectiveCode     PerspectiveCode
  instrumentVersionId String             @db.Char(36)
  package             MethodologyPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  instrumentVersion   InstrumentVersion  @relation(fields: [instrumentVersionId, perspectiveCode], references: [id, perspectiveCode], onDelete: Restrict, onUpdate: Restrict)
  @@id([packageId, perspectiveCode])
  @@index([instrumentVersionId, perspectiveCode])
}

model InstrumentScaleOption {
  instrumentVersionId String            @db.Char(36)
  valueCode           String            @db.VarChar(4)
  label               String            @db.VarChar(120)
  displayOrder        Int
  instrumentVersion   InstrumentVersion @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  @@id([instrumentVersionId, valueCode])
  @@unique([instrumentVersionId, displayOrder])
}

model InstrumentSection {
  id                  String            @id @default(uuid()) @db.Char(36)
  instrumentVersionId String            @db.Char(36)
  elementCode         ElementCode?
  label               String            @db.VarChar(40)
  title               String            @db.VarChar(160)
  introduction        String?           @db.Text
  instructions        String?           @db.Text
  displayOrder        Int
  instrumentVersion   InstrumentVersion @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  questions           QuestionVersion[]
  @@unique([instrumentVersionId, displayOrder])
  @@unique([instrumentVersionId, id])
}

model QuestionVersion {
  id                  String               @id @default(uuid()) @db.Char(36)
  instrumentVersionId String               @db.Char(36)
  sectionId           String               @db.Char(36)
  code                String               @db.VarChar(32)
  kind                QuestionKind
  elementCode         ElementCode?
  text                String               @db.Text
  orientation         QuestionOrientation?
  allowNA             Boolean
  officialOrder       Int
  orderInElement      Int?
  displayOrder        Int
  sourceGlobalId      Int?
  sourceOfficialCode  String?              @db.VarChar(32)
  sourceLocator       String               @db.VarChar(120)
  instrumentVersion   InstrumentVersion    @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)
  section             InstrumentSection    @relation(fields: [instrumentVersionId, sectionId], references: [instrumentVersionId, id], onDelete: Restrict)
  responses           SurveyResponse[]
  @@unique([instrumentVersionId, code])
  @@unique([instrumentVersionId, displayOrder])
  @@unique([instrumentVersionId, id])
}

model ClosureRecord {
  id               String          @id @default(uuid()) @db.Char(36)
  assessmentId     String          @db.Char(36)
  revisionNumber   Int
  checklistJson    Json?
  actaJson         Json?
  actaHash         String?         @db.Char(64)
  authorizedById   String?         @db.Char(36)
  authorizedAt     DateTime?       @db.DateTime(3)
  createdAt        DateTime        @default(now()) @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @db.DateTime(3)
  assessment       Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  authorizedBy     User?           @relation("ClosureAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshot         FrozenSnapshot?
  @@unique([assessmentId, revisionNumber])
  @@index([authorizedById])
}

model QualityAssessment {
  id              String           @id @default(uuid()) @db.Char(36)
  assessmentId    String           @db.Char(36)
  revisionNumber  Int
  scopeKey        String           @db.VarChar(16)
  perspectiveCode PerspectiveCode?
  elementCode     ElementCode?
  verdict         QualityVerdict
  reservations    String?          @db.Text
  reviewedById    String           @db.Char(36)
  reviewedAt      DateTime         @db.DateTime(3)
  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  reviewedBy      User             @relation("QualityReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  @@unique([assessmentId, revisionNumber, scopeKey])
  @@index([reviewedById])
}

model Exclusion {
  id                String          @id @default(uuid()) @db.Char(36)
  assessmentId      String          @db.Char(36)
  revisionNumber    Int
  responseSessionId String          @db.Char(36)
  reasonCode        ExclusionReason
  description       String          @db.Text
  authorizedById    String          @db.Char(36)
  authorizedAt      DateTime        @db.DateTime(3)
  revokedById       String?         @db.Char(36)
  revokedAt         DateTime?       @db.DateTime(3)
  assessment        Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  responseSession   ResponseSession @relation(fields: [assessmentId, responseSessionId], references: [assessmentId, id], onDelete: Restrict, onUpdate: Restrict)
  authorizedBy      User            @relation("ExclusionAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  revokedBy         User?           @relation("ExclusionRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([assessmentId, revisionNumber, responseSessionId])
  @@index([authorizedById])
  @@index([revokedById])
}

model Incident {
  id              String           @id @default(uuid()) @db.Char(36)
  assessmentId    String           @db.Char(36)
  revisionNumber  Int
  occurredOn      DateTime         @db.Date
  perspectiveCode PerspectiveCode?
  description     String           @db.Text
  impact          String           @db.Text
  action          String           @db.Text
  responsible     String           @db.VarChar(160)
  createdById     String           @db.Char(36)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([assessmentId, revisionNumber])
  @@index([createdById])
}

model FrozenSnapshot {
  id              String          @id @default(uuid()) @db.Char(36)
  assessmentId    String          @db.Char(36)
  revisionNumber  Int
  closureRecordId String          @unique @db.Char(36)
  schemaVersion   Int
  payloadJson     Json
  sha256          String          @db.Char(64)
  frozenById      String          @db.Char(36)
  frozenAt        DateTime        @db.DateTime(3)
  assessment      Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  closureRecord   ClosureRecord   @relation(fields: [closureRecordId], references: [id], onDelete: Restrict)
  frozenBy        User            @relation("SnapshotFrozenBy", fields: [frozenById], references: [id], onDelete: Restrict)
  runs            ProcessingRun[]
  @@unique([assessmentId, revisionNumber])
  @@index([frozenById])
}

model ProcessingRun {
  id               String           @id @default(uuid()) @db.Char(36)
  assessmentId     String           @db.Char(36)
  snapshotId       String           @db.Char(36)
  engineVersion    String           @db.VarChar(16)
  status           ProcessingStatus
  publishable      Boolean          @default(false)
  inputHash        String?          @db.Char(64)
  outputHash       String?          @db.Char(64)
  outputJson       Json?
  errorMessage     String?          @db.VarChar(500)
  requestedById    String           @db.Char(36)
  requestedAt      DateTime         @db.DateTime(3)
  finishedAt       DateTime         @db.DateTime(3)
  assessment       Assessment       @relation("AssessmentRuns", fields: [assessmentId], references: [id], onDelete: Restrict)
  snapshot         FrozenSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  requestedBy      User             @relation("RunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  currentFor       Assessment?      @relation("AssessmentCurrentRun")
  perspectiveElements PerspectiveElementResult[]
  elements         ElementResult[]
  perspectiveIndexes PerspectiveIndexResult[]
  global           GlobalResult?
  patterns         TriangulationPattern[]
  qualitativeReviews QualitativeReview[]
  disclosureReviews DisclosureReview[]
  @@index([assessmentId, requestedAt])
  @@index([snapshotId])
  @@index([requestedById])
}

model PerspectiveElementResult {
  runId           String          @db.Char(36)
  perspectiveCode PerspectiveCode
  elementCode     ElementCode
  status          String          @db.VarChar(8)
  reason          String?         @db.VarChar(32)
  validPiCount    Int
  rpExact         String?         @db.VarChar(200)
  rpDecimal       Decimal?        @db.Decimal(30, 18)
  run             ProcessingRun   @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@id([runId, perspectiveCode, elementCode])
}

model ElementResult {
  runId                 String        @db.Char(36)
  elementCode           ElementCode
  riStatus              String        @db.VarChar(12)
  riExact               String?       @db.VarChar(200)
  riDecimal             Decimal?      @db.Decimal(30, 18)
  validPerspectiveCount Int
  perspectivesJson      Json
  btStatus              String        @db.VarChar(16)
  btExact               String?       @db.VarChar(200)
  btDecimal             Decimal?      @db.Decimal(30, 18)
  btDisplay             Int?
  btClass               String?       @db.VarChar(24)
  maxPerspectivesJson   Json
  minPerspectivesJson   Json
  run                   ProcessingRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@id([runId, elementCode])
}

model PerspectiveIndexResult {
  runId             String          @db.Char(36)
  perspectiveCode   PerspectiveCode
  status            String          @db.VarChar(8)
  validElementCount Int
  valueExact        String?         @db.VarChar(200)
  valueDecimal      Decimal?        @db.Decimal(30, 18)
  displayScore      Int?
  healthLevel       Int?
  trafficLight      String?         @db.VarChar(16)
  run               ProcessingRun   @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@id([runId, perspectiveCode])
}

model GlobalResult {
  runId                  String        @id @db.Char(36)
  status                 String        @db.VarChar(8)
  reason                 String?       @db.VarChar(32)
  valueExact             String?       @db.VarChar(200)
  valueDecimal           Decimal?      @db.Decimal(30, 18)
  displayScore           Int?
  healthLevel            Int?
  healthLabel            String?       @db.VarChar(40)
  trafficLight           String?       @db.VarChar(16)
  integratedElementCount Int
  limitedElementsJson    Json
  run                    ProcessingRun @relation(fields: [runId], references: [id], onDelete: Restrict)
}

model TriangulationPattern {
  id            String                   @id @default(uuid()) @db.Char(36)
  runId         String                   @db.Char(36)
  elementCode   ElementCode
  patternCode   TriangulationPatternCode
  justification String                   @db.Text
  recordedById  String                   @db.Char(36)
  recordedAt    DateTime                 @db.DateTime(3)
  run           ProcessingRun            @relation(fields: [runId], references: [id], onDelete: Restrict)
  recordedBy    User                     @relation("PatternRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  @@index([runId, elementCode, recordedAt])
  @@index([recordedById])
}

model QualitativeReview {
  id                 String            @id @default(uuid()) @db.Char(36)
  runId              String            @db.Char(36)
  surveyResponseId   String            @db.Char(36)
  status             QualitativeStatus
  redactedCiphertext String?           @db.Text
  reviewedById       String            @db.Char(36)
  reviewedAt         DateTime          @db.DateTime(3)
  run                ProcessingRun     @relation(fields: [runId], references: [id], onDelete: Restrict)
  surveyResponse     SurveyResponse    @relation(fields: [surveyResponseId], references: [id], onDelete: Restrict)
  reviewedBy         User              @relation("QualitativeReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  @@index([runId, surveyResponseId, reviewedAt])
  @@index([surveyResponseId])
  @@index([reviewedById])
}

model DisclosureReview {
  id              String             @id @default(uuid()) @db.Char(36)
  runId           String             @db.Char(36)
  perspectiveCode PerspectiveCode
  decision        DisclosureDecision
  reason          String             @db.Text
  reviewedById    String             @db.Char(36)
  reviewedAt      DateTime           @db.DateTime(3)
  run             ProcessingRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  reviewedBy      User               @relation("DisclosureReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  @@index([runId, perspectiveCode, reviewedAt])
  @@index([reviewedById])
}
